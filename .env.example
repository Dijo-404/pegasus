# Run: uv run python scripts/setup_environment.py (creates private .env keys locally)
OWNER_TOKEN=
AGENT_TOKEN=
GRANT_SECRET=
DATA_KEY=
DATABASE_PATH=.local/pegasus.db

# Trusted backend only. An empty key disables live Bitrefill calls.
BITREFILL_API_KEY=
MAX_PURCHASE_MINOR=500
MAX_DAILY_MINOR=1000
ALLOWED_PRODUCTS=airtel-india,delos-syldavia
ALLOWED_COUNTRIES=IN
# Explicitly allow your own receipt email and team recipients before checkout.
ALLOWED_EMAILS=
ALLOWED_RECIPIENTS=
QUOTE_TTL_SECONDS=300
GRANT_TTL_SECONDS=90

# Separate Zcash-native merchant. Receiver can be a watch-only account.
ZCASH_ENABLED=false
ZCASH_GRAPHQL_URL=http://127.0.0.1:8000/graphql
ZCASH_ACCOUNT_ID=1
ZCASH_CONFIRMATIONS=1
ZCASH_AMOUNT_ZATS=100000
# Optional demo wallet address / viewing-key placeholders (never a spending key):
# ZCASH_DEMO_ADDRESS=utest1...
# ZCASH_DEMO_UFVK=uviewtest...
# ZCASH_DEMO_BIRTH_HEIGHT=
